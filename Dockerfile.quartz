FROM node:22-alpine
WORKDIR /home/wiki

# Node.js + Python3 + cron + curl（rebuild.sh 需要）
RUN apk add --no-cache python3 curl dcron

# 安装 Quartz 依赖
COPY package.json package-lock.json ./
RUN npm ci

# 复制源码
COPY quartz.config.ts quartz.layout.ts tsconfig.json globals.d.ts index.d.ts ./
COPY quartz/ ./quartz/
COPY scripts/ ./scripts/
COPY crawlers/ ./crawlers/
COPY content/ ./content/

# 安装爬虫依赖
RUN cd /home/wiki/crawlers && npm ci 2>/dev/null || true

# 设置每日凌晨 2:00 的 cron 任务
RUN echo "0 2 * * * /home/wiki/scripts/rebuild.sh >> /var/log/wiki-rebuild.log 2>&1" \
    > /etc/crontabs/root

# 启动脚本
COPY entrypoint.sh ./
RUN chmod +x ./entrypoint.sh ./scripts/rebuild.sh

CMD ["./entrypoint.sh"]
