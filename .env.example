# DeepSeek API Key（用于 AI 搜索 + 爬虫摘要）
DEEPSEEK_API_KEY=sk-your-key-here

# 站点域名（不要带协议；项目 Pages 示例: FDogeLover.github.io/Quart）
SITE_DOMAIN=FDogeLover.github.io/Quart

# Cloudflare Worker 的完整搜索地址；留空时网站自动使用本地静态搜索
AI_SEARCH_ENDPOINT=https://your-worker.workers.dev/api/search

# 内容保留天数和 Docker 本地自动重建周期（秒）
CONTENT_RETENTION_DAYS=30
REBUILD_INTERVAL_SECONDS=86400

# GitHub Personal Access Token（可选，提高 API 限流）
GITHUB_TOKEN=
