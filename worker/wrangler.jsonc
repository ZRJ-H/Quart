{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "doge-wiki-search",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "SITE_ORIGIN": "https://fdogelover.github.io",
    "INDEX_URL": "https://fdogelover.github.io/Quart/wiki-index.json",
  },
  "secrets": {
    "required": ["DEEPSEEK_API_KEY"],
  },
}
